# jeeflow-node demo Docker 镜像
FROM node:22-alpine
WORKDIR /app

# 安装依赖
COPY package.json package-lock.json ./
RUN npm install

# 复制源码
COPY tsconfig.json ./
COPY src/ /app/src/
COPY demo/ /app/demo/

# 复制共享 flows（demo/main.ts 的 flowsDir = __dirname/../../jeeflow-java/...，即容器根目录）
COPY jeeflow-java/jeeflow-core/src/test/resources/flows /jeeflow-java/jeeflow-core/src/test/resources/flows

EXPOSE 8082
CMD ["node", "--import", "tsx", "demo/main.ts"]