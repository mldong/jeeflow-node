# jeeflow-node demo Docker 镜像
FROM node:22-alpine
WORKDIR /app

# 安装依赖
COPY package.json package-lock.json ./
RUN npm install

# 复制源码
COPY tsconfig.json ./
COPY src/ /app/src/
COPY demo/ /app/demo/

# 流程定义用本仓 flows/ 副本（已入库，demo/main.ts 走 flows-resolver；用户单仓即可构建）
COPY flows /app/flows
COPY flows-resolver.ts /app/flows-resolver.ts

EXPOSE 8082
CMD ["node", "--import", "tsx", "demo/main.ts"]